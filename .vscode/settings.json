{
  // Mirrors pyproject.toml's [tool.pytest.ini_options] pythonpath -- Pylance
  // doesn't read that, so without this it can't resolve `common.*` (which
  // lives at src/layers/common, not src) or the authenticated_api/email_sender
  // sibling-module imports (`import app`, not relative).
  "python.analysis.extraPaths": [
    "src/layers/common",
    "src",
    "src/authenticated_api",
    "src/email_sender"
  ],

  // Quiets the YAML extension's "Unresolved tag" false positives on
  // CloudFormation/SAM's shorthand intrinsic-function tags (infra/**/template.yaml).
  // These are real, valid syntax -- `sam validate --lint` already confirms
  // that -- the generic YAML schema just doesn't know about them.
  "yaml.customTags": [
    "!And",
    "!And sequence",
    "!If",
    "!If sequence",
    "!Not",
    "!Not sequence",
    "!Equals",
    "!Equals sequence",
    "!Or",
    "!Or sequence",
    "!Condition",
    "!FindInMap",
    "!FindInMap sequence",
    "!Base64",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!Sub sequence",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!Select",
    "!Select sequence",
    "!Split",
    "!Split sequence",
    "!Join",
    "!Join sequence",
    "!Transform"
  ]
}
