{#
  Shared by ticket_approved and ticket_rejected. outcome_text carries the
  "has been approved.../was not approved..." tail, set by the Python
  function per type.
#}
{% extends "layout.html.jinja" %}
{% import "_macros.html.jinja" as m %}
{% block content %}
{% call m.p() %}{{ attendee_name }}'s ticket <strong>{{ ticket_code }}</strong> for <strong>{{ event_title }}</strong> {{ outcome_text }}{% endcall %}
{% if show_view_ticket %}{% call m.p() %}{{ m.button("View ticket", order_url) }}{% endcall %}{% endif %}
{% endblock %}
