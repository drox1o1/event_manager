{% extends "layout.html.jinja" %}
{% import "_macros.html.jinja" as m %}
{% block content %}
{% call m.p() %}We received a request to reset the password for your Showtik account. Choose a new one below.{% endcall %}
{% call m.p() %}{{ m.button("Reset password", url) }}{% endcall %}
{% call m.p() %}This link expires in <strong>{{ minutes }} minutes</strong> and can only be used once.{% endcall %}
{% call m.callout() %}Didn't ask for this? You can safely ignore this email — your password won't change.{% endcall %}
{% call m.muted() %}Button not working? Paste this link into your browser:<br>{{ url }}{% endcall %}
{% endblock %}
