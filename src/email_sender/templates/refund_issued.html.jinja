{% extends "layout.html.jinja" %}
{% import "_macros.html.jinja" as m %}
{% block heading %}Your refund is on its way{% endblock %}
{% block content %}
{% call m.p() %}Hi {{ buyer_name|default("there") }}, we've issued a refund for your booking.{% endcall %}
{% if reason %}{% call m.p() %}<strong>Reason:</strong> {{ reason }}{% endcall %}{% endif %}
{{ m.details([("Event", event_title), ("Order", order_code), ("Refund amount", amount), ("Refund reference", refund_reference)]) }}
{% call m.p() %}It usually appears on your original payment method within 5–7 working days, depending on your bank.{% endcall %}
{% endblock %}
