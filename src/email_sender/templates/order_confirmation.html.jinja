{% extends "layout.html.jinja" %}
{% import "_macros.html.jinja" as m %}
{% block preheader %}Payment received — your tickets for {{ event_title }} are inside.{% endblock %}
{% block heading %}Booking confirmed{% endblock %}
{% block content %}
{% for t in tickets %}
{% call m.p() %}Hi {{ t.attendee_name or buyer_name }},{% endcall %}
{% call m.p() %}Thank you for registering for <strong>{{ event_title }}</strong>.{% endcall %}
{% call m.p() %}We are pleased to confirm that your registration has been successfully completed. Please find your registration details below:{% endcall %}
<p style="margin:0 0 4px;font-weight:700;color:#051747;font-family:{{ font_display }}">Event details</p>
{% call m.p() %}Race category: <strong>{{ t.tier }}</strong>{% endcall %}
{{ m.bullets([
  ("Event name", event_title),
  ("Event date", (event_date|human_date) ~ " " ~ event_time),
  ("Booking ID", t.ticket_code),
  ("Status", "Awaiting organiser approval" if t.pending else None),
]) }}
{% for d in t.details|default([]) %}
{% call m.muted() %}{{ d }}{% endcall %}
{% endfor %}
{% if venue %}
{% call m.muted() %}📍 {{ venue }}{% endcall %}
{% endif %}
{% if not loop.last %}{{ m.divider() }}{% endif %}
{% endfor %}
{% call m.p() %}Order / payment ID: <strong style="font-family:monospace">{{ order_code }}</strong> · Total: <strong style="font-family:{{ font_display }}">{{ total }}</strong>{% endcall %}
{% call m.p() %}{{ m.button("View tickets", site() ~ "/order/" ~ order_id) }}{% endcall %}
{% call m.muted() %}Show your ticket ID at the entry gate.{% endcall %}
{% endblock %}
