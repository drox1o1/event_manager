{% extends "layout.html.jinja" %}
{% import "_macros.html.jinja" as m %}
{% block content %}
{% call m.p() %}Hi {{ buyer_name }}, you're going to <strong>{{ event_title }}</strong>!{% endcall %}
{% call m.p() %}📅 {{ when }}<br>📍 {{ venue }}{% endcall %}
<table role="presentation" width="100%" style="margin:0 0 16px;font-size:14px">
{% for t in tickets %}
<tr><td style="padding:10px 0;border-top:1px solid #eee">
<strong>{{ t.attendee_name }}</strong><br><span style="color:#666;font-size:13px">{{ t.tier }}</span>{% for d in t.details|default([]) %}<br><span style="color:#888;font-size:12px">{{ d }}</span>{% endfor %}
</td><td style="padding:10px 0;border-top:1px solid #eee;text-align:right;font-family:monospace">
{{ t.ticket_code }}{% if t.pending %}<br><span style="color:#B45309;font-size:12px">Awaiting approval</span>{% endif %}
</td></tr>
{% endfor %}
</table>
{% call m.p() %}Order / payment ID: <strong style="font-family:monospace">{{ order_code }}</strong> · Total: <strong style="font-family:{{ font_display }}">{{ total }}</strong>{% endcall %}
{% call m.p() %}{{ m.button("View tickets & QR codes", url) }}{% endcall %}
{% call m.muted() %}Show the QR code on your phone at the entry gate. Each ticket can be scanned once.{% endcall %}
{% endblock %}
